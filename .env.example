# AI generation (POST /api/generate) — set ONE of the two keys.
# Locally: copy to .env.local. On Vercel: Project Settings → Environment Variables.

# Preferred: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Which model OpenRouter should use. Any model that supports structured
# outputs / JSON schema works; Claude models are recommended.
# Examples: anthropic/claude-sonnet-4.5, anthropic/claude-opus-4.5
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Alternative: direct Anthropic API (used only if no OpenRouter key is set)
# ANTHROPIC_API_KEY=sk-ant-...
